# Stage 1: Build stage
FROM python:3.12-slim as builder

WORKDIR /app

# Install build-essential for any compiled python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install packages to a local folder to copy easily in next stage
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Final Runtime stage
FROM python:3.12-slim

WORKDIR /app

# Copy only the installed packages from the builder stage
COPY --from=builder /root/.local /root/.local
# Copy your source code
COPY src ./src

# Add the local bin to path so uvicorn can be found
ENV PATH=/root/.local/bin:$PATH
# Ensure logs and outputs are sent straight to terminal
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]